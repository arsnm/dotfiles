[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = refind
Target = shim-signed

[Action]
Description = Updating and signing rEFInd bootloader...
When = PostTransaction
Depends = refind
Depends = sbsigntools
Exec = /usr/bin/refind-install --shim /usr/share/shim-signed/shimx64.efi --localkeys --yes
